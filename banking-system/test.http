### Get account summary of savings account
GET http://localhost:52493/api/savings/summary
Accept: application/json

### Get account summary of current account
GET http://localhost:56671/api/current/summary
Accept: application/json

### Get account summary of fixed deposit account
GET http://localhost:56671/api/fixeddeposit/summary
Accept: application/json


### Post deposit for savings account
POST http://localhost:63223/api/savings/deposit
Content-Type: application/json

{
    "amount": -1
}

### Post deposit for current account
POST http://localhost:56671/api/current/deposit
Content-Type: application/json

{
    "amount": 600
}

### Post deposit for fixed deposit account
POST http://localhost:60123/api/fixeddeposit/deposit
Content-Type: application/json

{
    "amount": 700
}


### Post withdraw for savings account
POST http://localhost:63223/api/savings/withdraw
Content-Type: application/json

{
    "amount":400000
}

### Post withdraw for current account
POST http://localhost:60123/api/current/withdraw
Content-Type: application/json

{
    "amount":300
}

### Post withdraw for fixed deposit account
POST http://localhost:60123/api/fixeddeposit/withdraw
Content-Type: application/json

{
    "amount":200
}
